# 이 파일은 예시입니다. 실제 값은 .env 파일에 채워 넣고 커밋하지 마세요.

# App
NODE_ENV=development
PORT=3000
# 프론트엔드(Vite dev server) 오리진. CORS 허용 대상. 미설정 시 개발 기본값으로 폴백.
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres 접속 정보 (Supabase 프로젝트 설정 > Database 에서 확인)
# Supabase는 SSL 연결을 요구합니다.
DB_HOST=YOUR_SUPABASE_DB_HOST.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_DATABASE=postgres
DB_SSL=true
# 개발 단계에서만 true. 엔티티 확정 전까지는 마이그레이션 대신 synchronize로 스키마를 맞춘다.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRES_IN=1h

# Gemini API (일정 생성, PRD 6.2/6.3/12.4, WBS 2.2)
# Google AI Studio에서 발급한 API 키를 입력한다. 절대 실제 값을 커밋하지 말 것.
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
# 비용 절감을 위해 저비용 lite 등급 모델을 기본값으로 사용(WBS 6.4: 실제 무료 티어 한도는 배포 전 재확인).
# 주의: Gemini 모델은 서비스 종료(404)가 잦으므로, 값을 바꿀 때는 ListModels/직접 호출로
# generateContent 성공 여부를 반드시 재확인할 것(gemini-2.0-flash 계열/gemini-2.5-flash-lite는
# 2026-07-10 기준 이 프로젝트 키에서 404로 확인됨).
GEMINI_MODEL=gemini-3.1-flash-lite
